# JT-80x0 tour: factory programs, the Super Saw's DETUNE, the filter swept.
#   python3 tools/demo/demo.py tools/demo/tour.demo        -> build/demo/tour.mp4
# The format is in tools/demo/demo.py. 120 BPM: a 16th = 0.125 s.

name   JT-80x0
theme  amber
footer Rendered by the JT-80x0 firmware itself (tests/host.c): screen and sound as the engine makes them  ·  github.com/bk40-home/M-vance

0     title JT-80x0 | A JP-8000 style synth for the M-VAVE FM-1

# ---- programs ----
4     caption Plucks | Factory programs
4     pc 1                                   # Pluck 01
4.3   seq 0.125 C4,G4,D#5,G4,C5,G4,D5,G4,C4,G4,D#5,G4,F5,G4,D#5,D5 1 0.5
+2.3  pc 5                                   # Pluck 05
+0.3  seq 0.125 F4,C5,G#5,C5,F4,C5,G5,C5,D#4,A#4,G5,A#4,D#4,A#4,F5,G5 1 0.5

+2.4  caption Leads
+0    pc 13                                  # Lead 01
+0.3  note C5 0.45
+0.5  note D#5 0.45
+0.5  note G5 0.9
+1.0  note F5 0.45
+0.5  note D#5 1.2
+1.6  pc 20                                  # Lead 05
+0.3  note G4 0.45
+0.5  note A#4 0.45
+0.5  note C5 1.4

+2.0  caption Pads and strings
+0    pc 41                                  # Pad 01
+0.3  note C3,G3,D#4,A#4,D5 2.2
+2.4  note G#2,D#3,C4,G4,C5 2.4
+3.0  pc 55                                  # Strings 01
+0.3  note F3,C4,G#4,C5 2.2
+2.4  note D#3,A#3,G4,D5 2.4

+3.0  caption Bass | Sixteenths at 120 BPM
+0    pc 57                                  # Bass 01
+0.3  seq 0.125 C2,C2,C3,-,D#2,C2,G2,A#2,C2,-,C3,C2,D#3,C2,G2,F2 1 0.55
+2.3  pc 60                                  # Bass 04
+0.3  seq 0.125 F1,F1,F2,-,F1,G#1,-,A#1,C2,-,C2,D#2,F2,D#2,C2,A#1 1 0.6

+2.4  caption Arpeggiator | Hold a chord: the arp plays it
+0    pc 39                                  # Arp 01
+0.3  note C3,D#3,G3,A#3 3.6

# ---- the Super Saw: DETUNE from 0 up ----
+4.2  caption Super Saw | OSC 1 DETUNE turned from 0 to 127 on a held chord
+0    pc 42                                  # Pad 02, away and back to Pad 01: a fresh load
+0.1  pc 41
+0.1  press HOME
+0.1  press EDIT                             # OSC 1: WAVE, DETUNE, MIX
+0.1  turn KNOB2 -40                         # DETUNE 64 -> 0 (a quick turn steps x4)
+0.4  note C3,G3,D#4,A#4 9.0
+0.5  turn KNOB2 127 7.5                    # 59 ms apart: one step a detent

# ---- the filter swept ----
+9.2  caption The filter | LPF -24: CUTOFF swept with RESO up
+0    pc 42
+0.1  pc 41
+0.1  press HOME
+0.1  press SEL                              # FILTER 1/2: TYPE, SLOPE, CUTOFF, RESO
+0.1  turn KNOB4 20                          # RESO 0 -> 77: a quick turn steps x4 after its first detent (mv_ui.c)
+0.4  seq 0.25 C2,C3,C2,C3,D#2,D#3,G1,G2 4 0.8
+0    turn KNOB3 -60 3.5                     # CUTOFF down
+3.7  turn KNOB3 90 4.0                      # and up
+4.4  clear
+0.5  title JT-80x0 | github.com/bk40-home/M-vance
+4.0  end
